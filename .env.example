# Base de datos (PostgreSQL 16 + PostGIS 3).
DATABASE_URL=postgres://airline:airline@localhost:5432/airline_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Base de datos usada por los tests de integración. Se recrea en cada ejecución.
TEST_DATABASE_URL=postgres://airline:airline@localhost:5432/airline_test

# API
API_PORT=3000
API_HOST=0.0.0.0

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=200
